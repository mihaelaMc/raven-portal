<div class="mx-auto md:w-2/3 w-full">
  <p class="system-tag mb-3">// NEW ENTRANT</p>
  <h1 class="font-display text-4xl text-ember-400">Create Your Crawler</h1>
  <p class="mt-2 text-parchment-dim">Name yourself before the dungeon does it for you.</p>

  <% if @user.errors.any? %>
    <div class="mt-5 py-3 px-4 bg-blood-600/20 border border-blood-600 rounded-lg text-blood-500">
      <ul class="list-disc list-inside">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: registration_path, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.label :crawler_name, "Crawler Name", class: "system-tag block mb-2" %>
      <%= form.text_field :crawler_name, required: true, autofocus: true, placeholder: "What do they call you down there?", value: params.dig(:user, :crawler_name), class: "field-dark block rounded-md px-3 py-2 mt-1 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :email_address, "Email", class: "system-tag block mb-2" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username", placeholder: "you@example.com", value: params.dig(:user, :email_address), class: "field-dark block rounded-md px-3 py-2 mt-1 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :password, class: "system-tag block mb-2" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Something they can't guess", maxlength: 72, class: "field-dark block rounded-md px-3 py-2 mt-1 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :password_confirmation, "Confirm Password", class: "system-tag block mb-2" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Once more, for the waiver", maxlength: 72, class: "field-dark block rounded-md px-3 py-2 mt-1 w-full" %>
    </div>

    <div class="col-span-6 sm:flex sm:items-center sm:gap-4">
      <%= form.submit "Enter The Dungeon", class: "btn-torch w-full sm:w-auto text-center rounded px-4 py-2.5 cursor-pointer" %>
      <div class="mt-4 text-sm text-parchment-dim sm:mt-0">
        Already a crawler? <%= link_to "Sign in", new_session_path, class: "text-arcane-400 underline hover:no-underline" %>
      </div>
    </div>
  <% end %>
</div>
