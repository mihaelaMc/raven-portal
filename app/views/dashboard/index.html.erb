<div class="mx-auto w-full max-w-3xl">
  <% if notice = flash[:notice] %>
    <p class="py-2 px-3 bg-arcane-500/10 border border-arcane-500 mb-5 text-arcane-400 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <p class="system-tag mb-3">// STATUS WINDOW</p>
  <h1 class="font-display text-4xl text-ember-400">Welcome back, <%= @user.crawler_name %></h1>
  <p class="mt-2 text-parchment-dim">The dungeon remembers you. That's not always a good sign.</p>

  <div class="panel mt-10 rounded-lg p-6 grid sm:grid-cols-2 gap-6">
    <div>
      <p class="system-tag">Crawler</p>
      <p class="mt-1 text-lg"><%= @user.crawler_name %></p>
    </div>
    <div>
      <p class="system-tag">Registered Sigil (Email)</p>
      <p class="mt-1 text-lg"><%= @user.email_address %></p>
    </div>
    <div>
      <p class="system-tag">Floor</p>
      <p class="mt-1 text-lg text-arcane-400">01</p>
    </div>
    <div>
      <p class="system-tag">Status</p>
      <p class="mt-1 text-lg text-arcane-400">Alive (for now)</p>
    </div>
  </div>

  <div class="panel mt-6 rounded-lg p-6">
    <p class="system-tag mb-4">Active Delve Sessions</p>
    <ul class="space-y-2 font-system text-sm text-parchment-dim">
      <% @user.sessions.order(created_at: :desc).each do |session| %>
        <li class="flex justify-between border-b border-dungeon-700 pb-2">
          <span><%= session.ip_address %> &mdash; <%= session.user_agent&.truncate(50) %></span>
          <span><%= session.created_at.strftime("%b %d, %Y %H:%M") %></span>
        </li>
      <% end %>
    </ul>
  </div>
</div>
