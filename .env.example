# Copy to .env (which stays untracked) and fill in before `docker compose up`.

# Password for the bundled Postgres container.
POSTGRES_PASSWORD=change-me

# Rails' secret key base (signs the Devise JWTs, among other things).
# Generate one with: openssl rand -hex 64
SECRET_KEY_BASE=

# Optional: Resend API key for outgoing email (welcome + security alerts).
# Leave empty to disable email delivery entirely.
RESEND_API_KEY=
